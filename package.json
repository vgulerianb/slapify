{
  "name": "slapify",
  "version": "0.0.24",
  "description": "A fully autonomous browser agent: give it a goal in plain English and it browses, logs in, fills forms, handles files and tabs, and keeps going until it is done. Also runs plain-English E2E flows and performance audits.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slapify": "./bin/slapify.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.md",
    "bin",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/task/rules && cp -r src/task/rules dist/task/rules && cp src/browser/stealth-init.js dist/browser/stealth-init.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && AGENT_BROWSER_SESSION=slapify-test node --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous-agent",
    "browser-agent",
    "computer-use",
    "web-agent",
    "browser-automation",
    "testing",
    "e2e",
    "natural-language",
    "performance",
    "web-vitals",
    "task-runner",
    "browser",
    "slaps"
  ],
  "author": "slaps.dev",
  "license": "MIT",
  "homepage": "https://slaps.dev/slapify",
  "repository": {
    "type": "git",
    "url": "https://github.com/vgulerianb/slapify"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/groq": "^4.0.61",
    "@ai-sdk/mistral": "^4.0.64",
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/provider": "^4.0.27",
    "agent-browser": "^0.27.0",
    "ai": "^7.0.141",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "glob": "^13.0.6",
    "node-cron": "^4.2.1",
    "ora": "^8.0.1",
    "wreq-js": "^2.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "lighthouse": "^13.5.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "lighthouse": ">=12"
  },
  "peerDependenciesMeta": {
    "lighthouse": {
      "optional": true
    }
  }
}
